DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# AES-256 key, base64-encoded, exactly 32 bytes when decoded (e.g. `openssl
# rand -base64 32`). Encrypts the NERIS vendor client secret at rest
# (Department.nerisVendorSecretCipher) — see lib/crypto/secret-cipher.ts.
ENCRYPTION_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Absolute base URL of this deployment — used to build the redirectUrl for
# Clerk admin-invite emails (Clerk needs a fully-qualified URL, not a
# relative path). Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (https://resend.com) — Review & Approve status-change email
# notifications (Submitted needing review, Reviewed needing approval,
# kickback). NOTIFICATIONS_FROM_EMAIL must be a verified sender/domain in
# your Resend account.
RESEND_API_KEY=""
NOTIFICATIONS_FROM_EMAIL="notifications@example.com"

# Dedicated Clerk test user for npm run test:e2e (Playwright). Must exist in
# your Clerk dev instance with a password set — see TESTING.md's "E2E suite"
# section. Never a real user's credentials.
E2E_CLERK_USER_EMAIL=""
E2E_CLERK_USER_PASSWORD=""
E2E_CLERK_USER_ID=""
